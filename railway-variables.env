# ============================================================
# HI NOTIFKU — RAILWAY VARIABLES
# Copy variabel ini ke Railway > Variables.
# Jangan simpan token/key asli ke GitHub.
# Recommended: pasang Railway Volume pada /data
# ============================================================

# ===== WAJIB / SECRET =====
DISCORD_TOKEN=
OWNER_IDS=
YOUTUBE_API_KEY=

# ===== SERVER VERIFIKASI / SUPPORT =====
REQUIRED_GUILD_ID=
REQUIRED_GUILD_INVITE=

# ===== DATABASE / STORAGE =====
