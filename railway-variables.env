PAYMENT_EVENT_RETRY_SECONDS=120
PAYMENT_DUAL_APPROVAL_THRESHOLD=0
FULL_BACKUP_HOURS=168
BACKUP_ENCRYPTION_PASSWORD=
GIT_COMMIT=
BUILD_ID=

# ===== RELIABILITY PACK v1.21 =====
